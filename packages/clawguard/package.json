{
    "name": "@clawguard/core",
    "version": "0.1.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./bundler": {
            "import": "./dist/bundler/index.js",
            "types": "./dist/bundler/index.d.ts"
        },
        "./logging": {
            "import": "./dist/logging/hash-chain.js",
            "types": "./dist/logging/hash-chain.d.ts"
        },
        "./policy": {
            "import": "./dist/policy/evaluator.js",
            "types": "./dist/policy/evaluator.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:e2e": "tsx scripts/e2e-signed-approval.ts",
        "test:watch": "vitest",
        "verify-log": "tsx scripts/verify_log.ts",
        "start": "tsx src/server/index.ts"
    },
    "dependencies": {
        "@fastify/cors": "^9.0.0",
        "@mysten/sui": "^2.3.1",
        "archiver": "^7.0.0",
        "fastify": "^4.25.0",
        "js-yaml": "^4.1.0",
        "pino": "^8.17.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/archiver": "^6.0.0",
        "@types/js-yaml": "^4.0.9",
        "tsx": "^4.7.0",
        "vitest": "^1.0.0"
    }
}